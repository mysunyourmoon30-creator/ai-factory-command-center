@*
    The KPI tile markup was repeated roughly fifteen times across Home, Procurement,
    ProductionPlan and MaterialShortage, each with slightly different classes.

    Tone is driven by the value, not hardcoded: a zero shortage count reads neutral and a
    non-zero one reads as a warning, so the dashboard's colour actually carries information
    instead of decorating.
*@

<div class="kpi @ToneClass">
    @if (Icon is not null)
    {
        <span class="kpi-icon"><NavIcon Name="@Icon" /></span>
    }
    <span class="kpi-body">
        <span class="kpi-label">@Label</span>
        <span class="kpi-value">@Value</span>
        @if (!string.IsNullOrWhiteSpace(Caption))
        {
            <span class="kpi-caption">@Caption</span>
        }
    </span>
</div>

@code {
    public enum KpiTone { Neutral, Success, Warning, Danger }

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public object? Value { get; set; }

    /// <summary>Icon name understood by <see cref="NavIcon" />.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Optional secondary line under the value.</summary>
    [Parameter] public string? Caption { get; set; }

    [Parameter] public KpiTone Tone { get; set; } = KpiTone.Neutral;

    private string ToneClass => Tone switch
    {
        KpiTone.Danger => "kpi-danger",
        KpiTone.Warning => "kpi-warning",
        KpiTone.Success => "kpi-success",
        _ => "kpi-neutral"
    };
}
