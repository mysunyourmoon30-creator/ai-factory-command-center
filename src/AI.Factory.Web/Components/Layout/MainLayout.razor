@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="page-context">
                @if (!string.IsNullOrEmpty(Meta.Section))
                {
                    <span class="page-section">@Meta.Section</span>
                    <span class="page-separator" aria-hidden="true">/</span>
                }
                @* The real page heading, so removing each page's own duplicate <h1> does not
                   leave the document without one. Section above it is decoration, not structure. *@
                <h1 class="page-title">@Meta.Title</h1>
            </div>

            <div class="top-actions">
                @* Plain onclick, not @onclick: the toggle must work during prerender and while the
                   Interactive Server circuit is reconnecting. See wwwroot/theme.js. *@
                <button type="button" class="icon-button" onclick="aiFactoryToggleTheme()"
                        title="Switch between light and dark" aria-label="Switch between light and dark theme">
                    <span class="theme-icon-light" aria-hidden="true">&#x1F319;</span><span class="theme-icon-dark" aria-hidden="true">&#x2600;</span>
                </button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private PageMetadata.Entry Meta = PageMetadata.For("/");

    protected override void OnInitialized()
    {
        UpdateMeta();
        Navigation.LocationChanged += OnLocationChanged;
    }

    // The layout is not re-created on navigation, so the heading only follows the route if it
    // is told to re-render.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateMeta();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateMeta() =>
        Meta = PageMetadata.For("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/'));

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
