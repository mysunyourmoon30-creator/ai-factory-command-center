@page "/orders"
@attribute [Authorize]
@inject ICustomerOrderService Orders

<PageTitle>Customer Orders</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customer Orders</h1>
    <AuthorizeView Policy="@PolicyNames.CanManageOrders">
        <Authorized Context="createAuthorization"><a class="btn btn-primary" href="orders/new">Create order</a></Authorized>
    </AuthorizeView>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-5"><InputText class="form-control" @bind-Value="Search" placeholder="Order number or customer" /></div>
    <div class="col-md-3">
        <InputSelect class="form-select" @bind-Value="StatusFilter">
            <option value="">All lifecycle statuses</option>
            @foreach (var status in Enum.GetValues<CustomerOrderStatus>()) { <option value="@status">@status</option> }
        </InputSelect>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary" @onclick="ApplyFilterAsync">Filter</button></div>
</div>

@if (Page is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Order</th><th>Customer</th><th>Formulation</th><th class="text-end">Quantity</th><th>Delivery</th><th>Priority</th><th>Lifecycle</th><th>Risk</th></tr></thead>
        <tbody>
        @foreach (var order in Page.Items)
        {
            <tr>
                <td><a href="orders/@order.Id">@order.OrderNumber</a></td><td>@order.CustomerName</td><td>@order.FormulationCode</td>
                <td class="text-end">@order.Quantity.ToString("N3")</td><td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td><td>@order.Priority</td>
                <td><span class="badge text-bg-secondary">@order.LifecycleStatus</span></td>
                <td><span class="badge @RiskClass(order.RiskStatus)">@order.RiskStatus</span></td>
            </tr>
        }
        </tbody>
    </table>
    @if (Page.Items.Count == 0) { <div class="alert alert-light">No customer orders found.</div> }
    <div class="d-flex justify-content-between align-items-center">
        <span>@Page.TotalCount order(s)</span>
        <div>
            <button class="btn btn-sm btn-outline-secondary me-1" disabled="@(Page.Page <= 1)" @onclick="PreviousAsync">Previous</button>
            <span>Page @Page.Page of @TotalPages</span>
            <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@(Page.Page >= TotalPages)" @onclick="NextAsync">Next</button>
        </div>
    </div>
}

@code {
    private const int PageSize = 10;
    private CustomerOrderPage? Page;
    private string Search = "";
    private string StatusFilter = "";
    private int CurrentPage = 1;
    private int TotalPages => Page is null ? 1 : Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task ApplyFilterAsync() { CurrentPage = 1; await LoadAsync(); }
    private async Task PreviousAsync() { if (CurrentPage > 1) CurrentPage--; await LoadAsync(); }
    private async Task NextAsync() { if (CurrentPage < TotalPages) CurrentPage++; await LoadAsync(); }
    private async Task LoadAsync()
    {
        var status = Enum.TryParse<CustomerOrderStatus>(StatusFilter, out var parsed) ? parsed : (CustomerOrderStatus?)null;
        Page = await Orders.ListAsync(new(Search, status, CurrentPage, PageSize));
    }
    private static string RiskClass(RiskStatus risk) => risk switch { RiskStatus.Critical => "text-bg-danger", RiskStatus.Warning => "text-bg-warning", _ => "text-bg-success" };
}
