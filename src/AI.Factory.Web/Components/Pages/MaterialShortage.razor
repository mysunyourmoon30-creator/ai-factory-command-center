@page "/material-shortages"
@attribute [Authorize]
@inject IMaterialShortageService Shortages
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TimeProvider TimeProvider
@inject IJSRuntime JS

<PageTitle>Material Shortage</PageTitle>
<StatusMessage Message="@Message" Kind="@MessageKind" />

<h2 class="h4 mt-4">Material Shortage Report</h2>
@if (Rows.Count > 0)
{
    <div class="row g-3 mb-2">
        <div class="col-6 col-md-auto"><KpiCard Label="With Active Demand" Value="@Rows.Count" Icon="materials" /></div>
        <div class="col-6 col-md-auto"><KpiCard Label="Short" Value="@ShortCount" Icon="shortage" Tone="@(ShortCount > 0 ? KpiCard.KpiTone.Danger : KpiCard.KpiTone.Neutral)" /></div>
    </div>
    <div class="d-flex gap-2 align-items-end mb-2 flex-wrap">
        <div class="form-check"><input class="form-check-input" type="checkbox" id="shortageOnly" @bind="ShortageOnly" /><label class="form-check-label" for="shortageOnly">Shortage only</label></div>
        <a class="btn btn-outline-secondary" href="/api/reports/material-shortage/export.csv" target="_blank" rel="noopener noreferrer">Export CSV</a>
    </div>
}

@if (Rows.Count == 0)
{
    <EmptyState Message="No raw material has active demand."
                Hint="Demand appears once a Planned or InProduction plan requires a material." />
}
else if (FilteredRows.Count == 0)
{
    <EmptyState Message="Nothing is short right now." Hint="Clear &quot;Shortage only&quot; to see every material with active demand." />
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            @* Shortage and the date it is needed lead the row: they are the two figures the
               decision turns on. The supply breakdown that explains them follows. *@
            <thead><tr><th scope="col">Raw Material</th><th scope="col" class="text-end">Shortage</th><th scope="col">Required Date</th><th scope="col" class="text-end">Total Requirement</th><th scope="col" class="text-end">On-hand Available</th><th scope="col" class="text-end">Eligible Incoming</th><th scope="col" class="text-end">Projected Available</th><th scope="col"></th></tr></thead>
            <tbody>@foreach (var row in FilteredRows) {
                <tr class="@RowClass(row)">
                    <td>@row.RawMaterialCode - @row.RawMaterialName</td>
                    <td class="text-end"><span class="badge @(row.ShortageQuantity > 0 ? "text-bg-danger" : "text-bg-success")">@row.ShortageQuantity.ToString("N3", CultureInfo.InvariantCulture)</span></td>
                    <td>@(row.MaterialRequiredDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-")</td>
                    <td class="text-end">@row.TotalRequirement.ToString("N3", CultureInfo.InvariantCulture) @row.Unit</td>
                    <td class="text-end">@Math.Max(row.OnHandAvailable, 0).ToString("N3", CultureInfo.InvariantCulture) @if (row.OnHandAvailable < 0) { <span class="badge text-bg-danger ms-1">Negative</span> }</td>
                    <td class="text-end">@row.EligibleIncoming.ToString("N3", CultureInfo.InvariantCulture)</td>
                    <td class="text-end">@Math.Max(row.ProjectedAvailable, 0).ToString("N3", CultureInfo.InvariantCulture)</td>
                    <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => SelectAsync(row)">Detail</button></td>
                </tr>
            }</tbody>
        </table>
    </div>
}

@if (Selected is not null)
{
    <h2 class="h4 mt-4" id="shortage-detail">@Selected.RawMaterialCode Detail</h2>
    <p class="text-muted">Every figure is reported at evaluation date @(Selected.EvaluationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-").</p>

    <h3 class="h5">Affected Orders</h3>
    @if (Selected.AffectedOrders.Count == 0)
    {
        <EmptyState Message="No active plan requires this material." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm"><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Plan</th><th scope="col">Required Date</th><th scope="col" class="text-end">Required</th></tr></thead>
                <tbody>@foreach (var order in Selected.AffectedOrders) { <tr><td>@order.OrderNumber</td><td>@order.CustomerName</td><td>@order.PlanNumber</td><td>@order.RequiredDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td class="text-end">@order.RequiredQuantity.ToString("N3", CultureInfo.InvariantCulture)</td></tr> }</tbody></table>
        </div>
    }

    <h3 class="h5">Late Purchase Orders</h3>
    @if (Selected.LatePurchaseOrders.Count == 0)
    {
        <EmptyState Message="No late purchase order affects this material." />
    }
    else
    {
        <div class="alert alert-warning">Late purchase orders are shown for visibility and are never counted as eligible incoming supply.</div>
        <div class="table-responsive">
            <table class="table table-sm"><thead><tr><th scope="col">Purchase Order</th><th scope="col">Expected</th><th scope="col" class="text-end">Delay (days)</th><th scope="col" class="text-end">Outstanding</th></tr></thead>
                <tbody>@foreach (var late in Selected.LatePurchaseOrders) { <tr><td>@late.PurchaseOrderNumber</td><td>@late.ExpectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td class="text-end">@late.DelayDays</td><td class="text-end">@late.OutstandingQuantity.ToString("N3", CultureInfo.InvariantCulture)</td></tr> }</tbody></table>
        </div>
    }

    <AuthorizeView Policy="@PolicyNames.CanCreatePurchaseRequest">
        <Authorized Context="purchaseAuthorization">
            <h3 class="h5 mt-3">Create Purchase Request</h3>
            @if (Selected.ShortageQuantity <= 0)
            {
                <EmptyState Message="A purchase request can only be raised while a shortage remains." />
            }
            else if (Selected.AffectedOrders.Count == 0)
            {
                <EmptyState Message="No active plan is available to source the request." />
            }
            else
            {
                <EditForm Model="Input" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <div class="row g-2">
                        <div class="col-md-4"><label class="form-label" for="request-plan">Source plan</label><InputSelect id="request-plan" class="form-select" @bind-Value="Input.SourceProductionPlanId"><option value="0">Select plan</option>@foreach (var order in Selected.AffectedOrders) { <option value="@order.ProductionPlanId">@order.PlanNumber (@order.OrderNumber)</option> }</InputSelect></div>
                        <div class="col-md-4"><label class="form-label" for="request-quantity">Requested quantity</label><InputNumber id="request-quantity" class="form-control" @bind-Value="Input.RequestedQuantity" /></div>
                        <div class="col-md-4"><label class="form-label" for="request-expected">Expected date</label><InputDate id="request-expected" class="form-control" @bind-Value="Input.ExpectedDate" /></div>
                    </div>
                    <button class="btn btn-primary mt-2" type="submit" disabled="@Submitting">@(Submitting ? "Creating..." : "Create draft purchase request")</button>
                </EditForm>
            }
        </Authorized>
    </AuthorizeView>
}

@code {
    private IReadOnlyCollection<MaterialShortageDto> Rows = [];
    private MaterialShortageDto? Selected;
    private RequestInput Input = new();
    private string? Message;
    private StatusMessage.MessageKind MessageKind = StatusMessage.MessageKind.Info;
    private bool ShortageOnly;
    private bool Submitting;
    private int ShortCount => Rows.Count(x => x.ShortageQuantity > 0);
    private IReadOnlyCollection<MaterialShortageDto> FilteredRows => ShortageOnly ? Rows.Where(x => x.ShortageQuantity > 0).ToArray() : Rows;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        Rows = await Shortages.ListAsync();
        if (Selected is not null) Selected = Rows.SingleOrDefault(x => x.RawMaterialId == Selected.RawMaterialId);
    }

    // Selection wins over the shortage tint: it marks where the operator is looking, and the
    // shortage is still called out by the red badge in the row itself.
    private string? RowClass(MaterialShortageDto row) =>
        Selected?.RawMaterialId == row.RawMaterialId ? "table-active"
        : row.ShortageQuantity > 0 ? "table-danger"
        : null;

    private async Task SelectAsync(MaterialShortageDto row)
    {
        Selected = row;
        Input = new RequestInput
        {
            SourceProductionPlanId = row.AffectedOrders.Count == 1 ? row.AffectedOrders.First().ProductionPlanId : 0,
            RequestedQuantity = row.ShortageQuantity,
            ExpectedDate = row.MaterialRequiredDate ?? TimeProvider.GetUtcNow().UtcDateTime.Date.AddDays(1)
        };

        // The panel renders below a table that runs past the fold, so clicking Detail on a low row
        // used to look like nothing happened.
        try { await JS.InvokeVoidAsync("aiFactoryScrollIntoView", "shortage-detail"); }
        catch (JSException) { /* the panel is open and reachable by scrolling */ }
    }

    private async Task CreateAsync()
    {
        if (Selected is null || Submitting) return;
        Submitting = true;
        try
        {
            var created = await Shortages.CreatePurchaseRequestAsync(
                new(Selected.RawMaterialId, Input.SourceProductionPlanId, Input.RequestedQuantity, Input.ExpectedDate),
                await CurrentActorAsync());
            Message = $"Draft purchase request {created.RequestNumber} created."; MessageKind = StatusMessage.MessageKind.Success;
            await ReloadAsync();
        }
        catch (Exception ex) when (UserFacingError.IsExpected(ex)) { Message = ex.Message; MessageKind = StatusMessage.MessageKind.Error; }
        finally { Submitting = false; }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> CurrentActorAsync() => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

    private sealed class RequestInput
    {
        [System.ComponentModel.DataAnnotations.Range(1, long.MaxValue)] public long SourceProductionPlanId { get; set; }
        [System.ComponentModel.DataAnnotations.Range(0.001, double.MaxValue)] public decimal RequestedQuantity { get; set; }
        public DateTime ExpectedDate { get; set; }
    }
}
