@page "/material-shortages"
@attribute [Authorize]
@inject IMaterialShortageService Shortages
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TimeProvider TimeProvider

<PageTitle>Material Shortage</PageTitle>
<h1>Material Shortage</h1>
@if (!string.IsNullOrWhiteSpace(Message)) { <div class="alert alert-info">@Message</div> }

<h2 class="h4 mt-4">Material Shortage Report</h2>
@if (Rows.Count == 0) { <div class="alert alert-light">No raw material has active demand.</div> }
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Raw Material</th><th class="text-end">Total Requirement</th><th class="text-end">On-hand Available</th><th class="text-end">Eligible Incoming</th><th class="text-end">Projected Available</th><th class="text-end">Shortage</th><th>Required Date</th><th></th></tr></thead>
        <tbody>@foreach (var row in Rows) {
            <tr>
                <td>@row.RawMaterialCode - @row.RawMaterialName</td>
                <td class="text-end">@row.TotalRequirement.ToString("N3") @row.Unit</td>
                <td class="text-end">@Math.Max(row.OnHandAvailable, 0).ToString("N3") @if (row.OnHandAvailable < 0) { <span class="badge text-bg-danger ms-1">Negative</span> }</td>
                <td class="text-end">@row.EligibleIncoming.ToString("N3")</td>
                <td class="text-end">@Math.Max(row.ProjectedAvailable, 0).ToString("N3")</td>
                <td class="text-end"><span class="badge @(row.ShortageQuantity > 0 ? "text-bg-danger" : "text-bg-success")">@row.ShortageQuantity.ToString("N3")</span></td>
                <td>@(row.MaterialRequiredDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => Select(row)">Detail</button></td>
            </tr>
        }</tbody>
    </table>
}

@if (Selected is not null)
{
    <h2 class="h4 mt-4">@Selected.RawMaterialCode Detail</h2>
    <p class="text-muted">Every figure is reported at evaluation date @(Selected.EvaluationDate?.ToString("yyyy-MM-dd") ?? "-").</p>

    <h3 class="h5">Affected Orders</h3>
    @if (Selected.AffectedOrders.Count == 0) { <div class="alert alert-light">No active plan requires this material.</div> }
    else
    {
        <table class="table table-sm"><thead><tr><th>Order</th><th>Customer</th><th>Plan</th><th>Required Date</th><th class="text-end">Required</th></tr></thead>
            <tbody>@foreach (var order in Selected.AffectedOrders) { <tr><td>@order.OrderNumber</td><td>@order.CustomerName</td><td>@order.PlanNumber</td><td>@order.RequiredDate.ToString("yyyy-MM-dd")</td><td class="text-end">@order.RequiredQuantity.ToString("N3")</td></tr> }</tbody></table>
    }

    <h3 class="h5">Late Purchase Orders</h3>
    @if (Selected.LatePurchaseOrders.Count == 0) { <div class="alert alert-light">No late purchase order affects this material.</div> }
    else
    {
        <div class="alert alert-warning">Late purchase orders are shown for visibility and are never counted as eligible incoming supply.</div>
        <table class="table table-sm"><thead><tr><th>Purchase Order</th><th>Expected</th><th class="text-end">Delay (days)</th><th class="text-end">Outstanding</th></tr></thead>
            <tbody>@foreach (var late in Selected.LatePurchaseOrders) { <tr><td>@late.PurchaseOrderNumber</td><td>@late.ExpectedDate.ToString("yyyy-MM-dd")</td><td class="text-end">@late.DelayDays</td><td class="text-end">@late.OutstandingQuantity.ToString("N3")</td></tr> }</tbody></table>
    }

    <AuthorizeView Policy="@PolicyNames.CanCreatePurchaseRequest">
        <Authorized Context="purchaseAuthorization">
            <h3 class="h5 mt-3">Create Purchase Request</h3>
            @if (Selected.ShortageQuantity <= 0) { <div class="alert alert-light">A purchase request can only be raised while a shortage remains.</div> }
            else if (Selected.AffectedOrders.Count == 0) { <div class="alert alert-light">No active plan is available to source the request.</div> }
            else
            {
                <EditForm Model="Input" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <div class="row g-2">
                        <div class="col-md-4"><label class="form-label">Source plan</label><InputSelect class="form-select" @bind-Value="Input.SourceProductionPlanId"><option value="0">Select plan</option>@foreach (var order in Selected.AffectedOrders) { <option value="@order.ProductionPlanId">@order.PlanNumber (@order.OrderNumber)</option> }</InputSelect></div>
                        <div class="col-md-4"><label class="form-label">Requested quantity</label><InputNumber class="form-control" @bind-Value="Input.RequestedQuantity" /></div>
                        <div class="col-md-4"><label class="form-label">Expected date</label><InputDate class="form-control" @bind-Value="Input.ExpectedDate" /></div>
                    </div>
                    <button class="btn btn-primary mt-2" type="submit">Create draft purchase request</button>
                </EditForm>
            }
        </Authorized>
    </AuthorizeView>
}

@code {
    private IReadOnlyCollection<MaterialShortageDto> Rows = [];
    private MaterialShortageDto? Selected;
    private RequestInput Input = new();
    private string? Message;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        Rows = await Shortages.ListAsync();
        if (Selected is not null) Selected = Rows.SingleOrDefault(x => x.RawMaterialId == Selected.RawMaterialId);
    }

    private void Select(MaterialShortageDto row)
    {
        Selected = row;
        Input = new RequestInput
        {
            SourceProductionPlanId = row.AffectedOrders.Count == 1 ? row.AffectedOrders.First().ProductionPlanId : 0,
            RequestedQuantity = row.ShortageQuantity,
            ExpectedDate = row.MaterialRequiredDate ?? TimeProvider.GetUtcNow().UtcDateTime.Date.AddDays(1)
        };
    }

    private async Task CreateAsync()
    {
        if (Selected is null) return;
        try
        {
            var created = await Shortages.CreatePurchaseRequestAsync(
                new(Selected.RawMaterialId, Input.SourceProductionPlanId, Input.RequestedQuantity, Input.ExpectedDate),
                await CurrentActorAsync());
            Message = $"Draft purchase request {created.RequestNumber} created.";
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is DomainValidationException or BusinessConflictException or ConcurrencyConflictException) { Message = ex.Message; }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> CurrentActorAsync() => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

    private sealed class RequestInput
    {
        [System.ComponentModel.DataAnnotations.Range(1, long.MaxValue)] public long SourceProductionPlanId { get; set; }
        [System.ComponentModel.DataAnnotations.Range(0.001, double.MaxValue)] public decimal RequestedQuantity { get; set; }
        public DateTime ExpectedDate { get; set; }
    }
}
