@page "/materials"
@attribute [Authorize]
@inject IMasterDataService MasterData
@inject IMaterialRequirementQueryService MaterialRequirements

<PageTitle>Material Management</PageTitle>

<StatusMessage Message="@Message" Kind="@MessageKind" />

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button type="button" role="tab" aria-selected="@(Tab == "raw")" class="nav-link @(Tab == "raw" ? "active" : null)" @onclick='() => Tab = "raw"'>Raw Materials</button></li>
    <li class="nav-item"><button type="button" role="tab" aria-selected="@(Tab == "formulations")" class="nav-link @(Tab == "formulations" ? "active" : null)" @onclick='() => Tab = "formulations"'>Formulations</button></li>
    <li class="nav-item"><button type="button" role="tab" aria-selected="@(Tab == "requirements")" class="nav-link @(Tab == "requirements" ? "active" : null)" @onclick='() => Tab = "requirements"'>Material Requirements</button></li>
</ul>

@if (Tab == "raw")
{
    <div class="table-responsive">
        <table class="table table-striped"><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Stock</th><th scope="col">Reserved</th><th scope="col">Available</th><th scope="col">Lead time</th></tr></thead><tbody>
        @foreach (var item in RawMaterials) { <tr><td>@item.Code</td><td>@item.Name</td><td>@item.CurrentStock.ToString("N3", CultureInfo.InvariantCulture) @item.Unit</td><td>@item.ReservedStock.ToString("N3", CultureInfo.InvariantCulture)</td><td>@Math.Max(item.CurrentStock - item.ReservedStock, 0).ToString("N3", CultureInfo.InvariantCulture)</td><td>@item.LeadTimeDays days</td></tr> }
        </tbody></table>
    </div>
    <AuthorizeView Policy="@PolicyNames.CanManageMasterData"><Authorized Context="rawAuthorization">
        <h2 class="h4 mt-4">Create raw material</h2>
        @* Every field carries a real <label for>, not a placeholder. The second row used to be
           three bare number boxes - no label, no placeholder - so which one was stock, which was
           reserved and which was lead time was unguessable without reading the source. *@
        <EditForm Model="RawInput" OnValidSubmit="CreateRawAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="raw-code">Code</label>
                    <InputText id="raw-code" class="form-control" @bind-Value="RawInput.Code" placeholder="RM-011" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="raw-name">Name</label>
                    <InputText id="raw-name" class="form-control" @bind-Value="RawInput.Name" placeholder="Polymer Base B" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="raw-unit">Unit</label>
                    <InputText id="raw-unit" class="form-control" @bind-Value="RawInput.Unit" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="raw-stock">Current stock</label>
                    <InputNumber id="raw-stock" class="form-control" @bind-Value="RawInput.CurrentStock" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="raw-reserved">Reserved stock</label>
                    <InputNumber id="raw-reserved" class="form-control" @bind-Value="RawInput.ReservedStock" />
                    <div class="form-text">Already committed to active plans.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="raw-lead">Lead time (days)</label>
                    <InputNumber id="raw-lead" class="form-control" @bind-Value="RawInput.LeadTimeDays" />
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Create raw material</button>
        </EditForm>
    </Authorized></AuthorizeView>
}
else if (Tab == "requirements")
{
    <p class="text-muted">Cumulative active demand for every raw material, evaluated at each Required Date of Planned and InProduction plans. Figures below are shown at the last active Required Date.</p>
    <div class="table-responsive">
        <table class="table table-striped align-middle"><thead><tr><th scope="col">Raw Material</th><th scope="col" class="text-end">Required Quantity</th><th scope="col" class="text-end">Current Stock</th><th scope="col" class="text-end">Reserved Stock</th><th scope="col" class="text-end">Eligible Incoming</th><th scope="col" class="text-end">Projected Available</th><th scope="col" class="text-end">Shortage Quantity</th><th scope="col">As of</th></tr></thead><tbody>
        @foreach (var item in Availability)
        {
            <tr>
                <td>@item.RawMaterialCode - @item.RawMaterialName</td>
                <td class="text-end">@item.RequiredQuantity.ToString("N3", CultureInfo.InvariantCulture) @item.Unit</td>
                <td class="text-end">@item.CurrentStock.ToString("N3", CultureInfo.InvariantCulture)</td>
                <td class="text-end">@item.ReservedStock.ToString("N3", CultureInfo.InvariantCulture)</td>
                <td class="text-end">@item.EligibleIncoming.ToString("N3", CultureInfo.InvariantCulture)</td>
                <td class="text-end">@Math.Max(item.ProjectedAvailable, 0).ToString("N3", CultureInfo.InvariantCulture) @if (item.ProjectedAvailable < 0) { <span class="badge text-bg-danger ms-1">Negative</span> }</td>
                <td class="text-end">@if (item.ShortageQuantity > 0) { <span class="badge text-bg-danger">@item.ShortageQuantity.ToString("N3", CultureInfo.InvariantCulture)</span> } else { <text>-</text> }</td>
                <td>@(item.EvaluationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "No active demand")</td>
            </tr>
        }
        </tbody></table>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped"><thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Batch</th><th scope="col">Materials</th></tr></thead><tbody>
        @foreach (var item in Formulations) { <tr><td>@item.Code</td><td>@item.Name</td><td>@item.BatchSize.ToString("N3", CultureInfo.InvariantCulture) kg</td><td>@string.Join(", ", item.Materials.Select(x => $"{x.RawMaterialCode}: {x.WeightPerBatch.ToString("N3", CultureInfo.InvariantCulture)}"))</td></tr> }
        </tbody></table>
    </div>
    <AuthorizeView Policy="@PolicyNames.CanManageMasterData"><Authorized Context="formulationAuthorization">
        <h2 class="h4 mt-4">Create formulation</h2>
        <EditForm Model="FormulaInput" OnValidSubmit="CreateFormulaAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="formula-code">Code</label>
                    <InputText id="formula-code" class="form-control" @bind-Value="FormulaInput.Code" placeholder="FM-006" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="formula-name">Name</label>
                    <InputText id="formula-name" class="form-control" @bind-Value="FormulaInput.Name" placeholder="Formulation 006" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="formula-batch">Batch size (kg)</label>
                    <InputNumber id="formula-batch" class="form-control" @bind-Value="FormulaInput.BatchSize" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="formula-materials">Materials</label>
                    <InputTextArea id="formula-materials" class="form-control" rows="2" @bind-Value="FormulaInput.Materials" placeholder="RM-001:250, RM-002:150, RM-003:100" />
                    @* The format rule and the sum rule both used to be invisible until the server
                       rejected the submission. *@
                    <div class="form-text">
                        Comma-separated <code>CODE:WEIGHT</code> pairs. The weights must add up to
                        exactly the batch size above.
                    </div>
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Create formulation</button>
        </EditForm>
    </Authorized></AuthorizeView>
}

@code {
    private string Tab = "raw"; private string? Message;
    private StatusMessage.MessageKind MessageKind = StatusMessage.MessageKind.Info;
    private IReadOnlyCollection<RawMaterialDto> RawMaterials = []; private IReadOnlyCollection<FormulationDto> Formulations = [];
    private IReadOnlyCollection<MaterialAvailabilityDto> Availability = [];
    private RawForm RawInput = new(); private FormulaForm FormulaInput = new();
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync() { RawMaterials = await MasterData.ListRawMaterialsAsync(); Formulations = await MasterData.ListFormulationsAsync(); Availability = await MaterialRequirements.ListAvailabilityAsync(); }
    private async Task CreateRawAsync() { try { await MasterData.CreateRawMaterialAsync(new(RawInput.Code, RawInput.Name, RawInput.Unit, RawInput.CurrentStock, RawInput.ReservedStock, RawInput.LeadTimeDays, true)); RawInput = new(); Message = "Raw material created."; MessageKind = StatusMessage.MessageKind.Success; await ReloadAsync(); } catch (DomainValidationException ex) { Message = ex.Message; MessageKind = StatusMessage.MessageKind.Error; } }
    private async Task CreateFormulaAsync()
    {
        try
        {
            var commands = ParseMaterials(FormulaInput.Materials);
            await MasterData.CreateFormulationAsync(new(FormulaInput.Code, FormulaInput.Name, FormulaInput.BatchSize, true, commands));
            FormulaInput = new();
            Message = "Formulation created."; MessageKind = StatusMessage.MessageKind.Success;
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is DomainValidationException or FormatException or InvalidOperationException) { Message = ex.Message; MessageKind = StatusMessage.MessageKind.Error; }
    }

    // Every malformed entry now becomes a DomainValidationException naming the offending part.
    // Previously a missing colon indexed past the end of the split result, and
    // IndexOutOfRangeException is not in the catch filter above - one typo tore down the circuit
    // and left the page dead until a reload.
    private FormulationMaterialCommand[] ParseMaterials(string input)
    {
        var parts = input.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
            throw new DomainValidationException("Enter at least one material, for example RM-001:250.");

        return parts.Select(part =>
        {
            var pair = part.Split(':', StringSplitOptions.TrimEntries);
            if (pair.Length != 2 || string.IsNullOrWhiteSpace(pair[0]) || string.IsNullOrWhiteSpace(pair[1]))
                throw new DomainValidationException($"'{part}' is not in CODE:WEIGHT form, for example RM-001:250.");

            var raw = RawMaterials.SingleOrDefault(x => x.Code.Equals(pair[0], StringComparison.OrdinalIgnoreCase))
                ?? throw new DomainValidationException($"Raw material '{pair[0]}' does not exist.");

            if (!decimal.TryParse(pair[1], NumberStyles.Number, CultureInfo.InvariantCulture, out var weight))
                throw new DomainValidationException($"'{pair[1]}' is not a valid weight for {raw.Code}.");

            return new FormulationMaterialCommand(raw.Id, weight);
        }).ToArray();
    }
    private sealed class RawForm { [System.ComponentModel.DataAnnotations.Required] public string Code { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; public string Unit { get; set; } = "kg"; public decimal CurrentStock { get; set; } public decimal ReservedStock { get; set; } public int LeadTimeDays { get; set; } = 7; }
    private sealed class FormulaForm { [System.ComponentModel.DataAnnotations.Required] public string Code { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; public decimal BatchSize { get; set; } [System.ComponentModel.DataAnnotations.Required] public string Materials { get; set; } = ""; }
}
