@page "/ai-copilot"
@attribute [Authorize]
@inject ICopilotService Copilot
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>AI Factory Copilot</PageTitle>
<p class="text-muted">Read-only. The Copilot can summarize material shortages, delayed production orders, late purchase orders, and today's factory summary — it cannot change any data.</p>

<h2 class="h4">Supported Questions</h2>
<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick='() => Question = "What raw materials are short?"'>Material shortages</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick='() => Question = "Which production orders are delayed?"'>Delayed orders</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick='() => Question = "Which purchase orders are late?"'>Late purchase orders</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick='() => Question = "Give me the daily factory summary"'>Daily summary</button>
</div>

<div class="input-group mb-1">
    @* maxlength matches CopilotService.MaxQuestionLength. Without it a 2,000-character question
       travelled to the server purely to be rejected. *@
    <input class="form-control" maxlength="500" aria-label="Ask the Copilot a question" @bind="Question" @bind:event="oninput"
           placeholder="Ask about material shortages, delayed orders, late purchase orders, or today's summary" />
    <button class="btn btn-primary" type="button" disabled="@IsAsking" @onclick="AskAsync">Ask</button>
</div>
<div class="form-text mb-3">@Question.Length / 500 characters</div>

@* Announced, so a screen-reader user learns the answer arrived without having to go looking. *@
<div aria-live="polite">
    @if (IsAsking)
    {
        <EmptyState Message="Thinking..." Loading="true" />
    }

    @if (Response is not null)
    {
        @if (Response.IsFallback)
        {
            <h2 class="h4">Fallback State</h2>
            <div class="alert alert-warning">@Response.Summary</div>
        }
        else
        {
            <h2 class="h4">AI Response</h2>

            @* Which of the four allow-listed read-only tools the answer was grounded in. The
               orchestrator stamps this from the tool it selected; the model has no way to write
               it, so it cannot claim a source it did not use. *@
            @if (Response.ToolName is not null)
            {
                <p class="text-muted small mb-2">
                    Answered from <strong>@Response.ToolName</strong> — @Response.ToolPurpose Read-only; no data was changed.
                </p>
            }

            <p>@Response.Summary</p>
            @if (Response.RiskLevel is not null)
            {
                <p>Risk Level: <StatusBadge Risk="Response.RiskLevel.Value" /></p>
            }
            @if (Response.AffectedOrders.Count > 0)
            {
                @* System data the tool returned, kept visually apart from the model's suggestions
                   below it: the two used to render as indistinguishable bulleted lists. *@
                <h3 class="h5">Affected Orders <span class="badge text-bg-secondary align-middle">from system data</span></h3>
                <ul>@foreach (var order in Response.AffectedOrders) { <li>@order</li> }</ul>
            }
            @if (Response.RecommendedActions.Count > 0)
            {
                <h3 class="h5">Recommended Actions <span class="badge text-bg-warning align-middle">AI suggestion</span></h3>
                <p class="text-muted small mb-1">Generated by the model, not by a business rule. Check them against the Material Shortage and Procurement screens before acting.</p>
                <ul>@foreach (var action in Response.RecommendedActions) { <li>@action</li> }</ul>
            }
        }
    }
</div>

@code {
    private string Question = "";
    private CopilotResponseDto? Response;
    private bool IsAsking;

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(Question) || IsAsking) return;
        IsAsking = true;
        Response = null;
        try
        {
            Response = await Copilot.AskAsync(new AskCopilotCommand(Question), await CurrentActorAsync());
        }
        catch (DomainValidationException exception)
        {
            Response = new CopilotResponseDto(exception.Message, null, [], [], IsFallback: true);
        }
        finally
        {
            IsAsking = false;
        }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> CurrentActorAsync() => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

}
