@page "/"
@attribute [Authorize]
@inject IDashboardService Dashboard

<PageTitle>AI Factory Command Center</PageTitle>
<h1>Dashboard</h1>

@if (Kpi is null)
{
    <EmptyState Message="Loading dashboard..." Loading="true" />
}
else
{
    <div class="row g-3 row-cols-2 row-cols-md-4">
        <div class="col"><KpiCard Label="Customer Orders" Value="@Kpi.CustomerOrderCount" /></div>
        <div class="col"><KpiCard Label="Production Plans" Value="@Kpi.ProductionPlanCount" /></div>
        <div class="col"><KpiCard Label="Orders at Risk" Value="@Kpi.OrdersAtRiskCount" /></div>
        <div class="col"><KpiCard Label="Material Shortages" Value="@Kpi.MaterialShortageCount" /></div>
        <div class="col"><KpiCard Label="Late Purchase Orders" Value="@Kpi.LatePurchaseOrderCount" /></div>
        <div class="col"><KpiCard Label="Machine Alerts" Value="@Kpi.MachineAlertCount" /></div>
        <div class="col"><KpiCard Label="Critical Risks" Value="@Kpi.CriticalRiskCount" Emphasis="true" /></div>
    </div>
}

<h2 class="h4 mt-4">Critical Risks</h2>
@if (CriticalRisks is null)
{
    <EmptyState Message="Loading critical risks..." Loading="true" />
}
else if (CriticalRisks.DelayedOrders.Count == 0 && CriticalRisks.CriticalMachines.Count == 0)
{
    <div class="alert alert-success" role="status">No critical risk is currently active.</div>
}
else
{
    @if (CriticalRisks.DelayedOrders.Count > 0)
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm"><thead><tr><th scope="col">Order</th><th scope="col">Delivery</th><th scope="col">Planned Completion</th><th scope="col" class="text-end">Delay (days)</th></tr></thead>
                <tbody>@foreach (var order in CriticalRisks.DelayedOrders) { <tr><td>@order.OrderNumber</td><td>@order.DeliveryDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td>@order.PlannedCompletionDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td class="text-end"><span class="badge text-bg-danger">@order.DelayRiskDays</span></td></tr> }</tbody></table>
        </div>
    }
    @if (CriticalRisks.CriticalMachines.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm"><thead><tr><th scope="col">Machine</th><th scope="col" class="text-end">Temperature</th><th scope="col" class="text-end">Speed</th></tr></thead>
                <tbody>@foreach (var machine in CriticalRisks.CriticalMachines) { <tr><td>@machine.MachineCode</td><td class="text-end">@machine.Temperature.ToString("N0")&deg;C</td><td class="text-end">@machine.Speed.ToString("N0")</td></tr> }</tbody></table>
        </div>
    }
}

<h2 class="h4 mt-4">Daily Factory Summary</h2>
@if (DailySummary is not null)
{
    <dl class="row">
        <dt class="col-sm-3">As of</dt><dd class="col-sm-9">@DailySummary.AsOfDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
        <dt class="col-sm-3">Customer Orders</dt><dd class="col-sm-9">@DailySummary.CustomerOrderCount</dd>
        <dt class="col-sm-3">Production Plans</dt><dd class="col-sm-9">@DailySummary.ProductionPlanCount</dd>
        <dt class="col-sm-3">Material Shortages</dt><dd class="col-sm-9">@DailySummary.MaterialShortageCount</dd>
        <dt class="col-sm-3">Late Purchase Orders</dt><dd class="col-sm-9">@DailySummary.LatePurchaseOrderCount</dd>
        <dt class="col-sm-3">Critical Machines</dt><dd class="col-sm-9">@DailySummary.CriticalMachineCount</dd>
    </dl>
}

<h2 class="h4 mt-4">Alert List</h2>
@if (Alerts is null) { <EmptyState Message="Loading alerts..." Loading="true" /> }
else if (Alerts.Count == 0) { <EmptyState Message="No active alert." Hint="Alerts resolve themselves once the underlying condition clears." /> }
else
{
    <div class="table-responsive">
        <table class="table table-sm"><thead><tr><th scope="col">Type</th><th scope="col">Severity</th><th scope="col">Entity</th><th scope="col">Message</th><th scope="col">Created</th></tr></thead>
            <tbody>@foreach (var alert in Alerts) { <tr><td>@alert.AlertType</td><td><StatusBadge Severity="alert.Severity" /></td><td>@alert.EntityName #@alert.EntityId</td><td>@alert.Message</td><td>@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td></tr> }</tbody></table>
    </div>
}

@code {
    private DashboardKpiDto? Kpi;
    private DailySummaryDto? DailySummary;
    private CriticalRisksDto? CriticalRisks;
    private IReadOnlyCollection<ActiveAlertDto>? Alerts;

    protected override async Task OnInitializedAsync()
    {
        Kpi = await Dashboard.GetKpiAsync();
        DailySummary = await Dashboard.GetDailySummaryAsync();
        CriticalRisks = await Dashboard.GetCriticalRisksAsync();
        Alerts = await Dashboard.ListActiveAlertsAsync();
    }
}
