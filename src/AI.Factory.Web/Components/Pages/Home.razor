@page "/"
@attribute [Authorize]
@inject IDashboardService Dashboard
@inject TimeProvider TimeProvider

<PageTitle>AI Factory Command Center</PageTitle>

@if (Kpi is null)
{
    <EmptyState Message="Loading dashboard..." Loading="true" />
}
else
{
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-4">
        <div class="col"><KpiCard Label="Customer Orders" Value="@Kpi.CustomerOrderCount" Icon="orders" Href="orders" /></div>
        <div class="col"><KpiCard Label="Production Plans" Value="@Kpi.ProductionPlanCount" Icon="plans" Href="production-plans" /></div>
        <div class="col"><KpiCard Label="Orders at Risk" Value="@Kpi.OrdersAtRiskCount" Icon="shortage" Tone="@Warn(Kpi.OrdersAtRiskCount)" Href="orders" /></div>
        <div class="col"><KpiCard Label="Material Shortages" Value="@Kpi.MaterialShortageCount" Icon="materials" Tone="@Warn(Kpi.MaterialShortageCount)" Href="material-shortages" /></div>
        <div class="col"><KpiCard Label="Late Purchase Orders" Value="@Kpi.LatePurchaseOrderCount" Icon="procurement" Tone="@Warn(Kpi.LatePurchaseOrderCount)" Href="procurement" /></div>
        <div class="col"><KpiCard Label="Machine Alerts" Value="@Kpi.MachineAlertCount" Icon="machines" Tone="@Warn(Kpi.MachineAlertCount)" Href="machine-monitoring" /></div>
        @* Critical Risks has no screen of its own - it is the sum of delayed orders and critical
           machines, both broken out in the section directly below. *@
        <div class="col"><KpiCard Label="Critical Risks" Value="@Kpi.CriticalRiskCount" Icon="shortage" Tone="@Danger(Kpi.CriticalRiskCount)" Href="#critical-risks" /></div>
    </div>
    <p class="text-muted mt-2 mb-0" style="font-size: var(--af-text-xs);">
        Read live from the database as of @TimeProvider.GetUtcNow().UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture).
    </p>
}

<h2 class="h4 mt-4" id="critical-risks">Critical Risks</h2>
@if (CriticalRisks is null)
{
    <EmptyState Message="Loading critical risks..." Loading="true" />
}
else if (CriticalRisks.DelayedOrders.Count == 0 && CriticalRisks.CriticalMachines.Count == 0)
{
    <div class="alert alert-success" role="status">No critical risk is currently active.</div>
}
else
{
    @if (CriticalRisks.DelayedOrders.Count > 0)
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm"><thead><tr><th scope="col">Order</th><th scope="col">Delivery</th><th scope="col">Planned Completion</th><th scope="col" class="text-end">Delay (days)</th></tr></thead>
                <tbody>@foreach (var order in CriticalRisks.DelayedOrders) { <tr><td>@order.OrderNumber</td><td>@order.DeliveryDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td>@order.PlannedCompletionDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td class="text-end"><span class="badge text-bg-danger">@order.DelayRiskDays</span></td></tr> }</tbody></table>
        </div>
    }
    @if (CriticalRisks.CriticalMachines.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm"><thead><tr><th scope="col">Machine</th><th scope="col" class="text-end">Temperature</th><th scope="col" class="text-end">Speed</th></tr></thead>
                <tbody>@foreach (var machine in CriticalRisks.CriticalMachines) { <tr><td>@machine.MachineCode</td><td class="text-end">@machine.Temperature.ToString("N0")&deg;C</td><td class="text-end">@machine.Speed.ToString("N0")</td></tr> }</tbody></table>
        </div>
    }
}

@* The "Daily Factory Summary" list that used to sit here repeated four of the five figures from
   the KPI cards above verbatim, so the reader scrolled past the same numbers twice. Removed from
   this screen only: IDashboardService.GetDailySummaryAsync, /api/dashboard/daily-summary and the
   GetDailyFactorySummary AI tool are the locked §16.11 shape and are untouched.

   Its one non-redundant value, the as-of date, is kept as the caption under the cards. *@

<h2 class="h4 mt-4">Alert List</h2>
@if (Alerts is null) { <EmptyState Message="Loading alerts..." Loading="true" /> }
else if (Alerts.Count == 0) { <EmptyState Message="No active alert." Hint="Alerts resolve themselves once the underlying condition clears." /> }
else
{
    <div class="table-responsive">
        <table class="table table-sm"><thead><tr><th scope="col">Type</th><th scope="col">Severity</th><th scope="col">Entity</th><th scope="col">Message</th><th scope="col">Created</th></tr></thead>
            <tbody>@foreach (var alert in Alerts) { <tr><td>@alert.AlertType</td><td><StatusBadge Severity="alert.Severity" /></td><td>@alert.EntityName #@alert.EntityId</td><td>@alert.Message</td><td>@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td></tr> }</tbody></table>
    </div>
}

@code {
    // Colour follows the number, so a clean factory shows a calm dashboard and any tint on the
    // row is genuinely worth looking at.
    private static KpiCard.KpiTone Warn(int count) => count > 0 ? KpiCard.KpiTone.Warning : KpiCard.KpiTone.Neutral;
    private static KpiCard.KpiTone Danger(int count) => count > 0 ? KpiCard.KpiTone.Danger : KpiCard.KpiTone.Neutral;

    private DashboardKpiDto? Kpi;
    private CriticalRisksDto? CriticalRisks;
    private IReadOnlyCollection<ActiveAlertDto>? Alerts;

    // Dropping GetDailySummaryAsync also drops a full duplicate run of the shortage engine and
    // the late-PO scan, both of which GetKpiAsync had already done for this same page load.
    // Sequential on purpose: these share one scoped AppDbContext, which is not thread-safe, so
    // Task.WhenAll here would be a concurrency bug rather than an optimisation.
    protected override async Task OnInitializedAsync()
    {
        Kpi = await Dashboard.GetKpiAsync();
        CriticalRisks = await Dashboard.GetCriticalRisksAsync();
        Alerts = await Dashboard.ListActiveAlertsAsync();
    }
}
