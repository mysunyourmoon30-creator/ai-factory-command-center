@page "/audit-administration"
@attribute [Authorize]
@inject IAuditLogService AuditLogs
@inject IAdminUserService AdminUsers
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Audit and Administration</PageTitle>
<StatusMessage Message="@Message" Kind="@MessageKind" />

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button type="button" role="tab" aria-selected="@(Tab == "audit")" class="nav-link @(Tab == "audit" ? "active" : null)" @onclick='() => Tab = "audit"'>Audit Log</button></li>
    <li class="nav-item"><button type="button" role="tab" aria-selected="@(Tab == "users")" class="nav-link @(Tab == "users" ? "active" : null)" @onclick='() => Tab = "users"'>Demo User Management</button></li>
</ul>

@if (Tab == "audit")
{
    <AuthorizeView Policy="@PolicyNames.CanViewAuditLog">
        <Authorized Context="viewAuthorization">
            <h2 class="h4">Audit Log Report</h2>
            <div class="row g-3 mb-2">
                <div class="col-6 col-md-auto"><KpiCard Label="Matching Entries" Value="@AuditPage.TotalCount" Icon="admin" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-3"><label class="form-label">Search (user or entity)</label><input class="form-control" @bind="SearchInput" /></div>
                <div class="col-md-3"><label class="form-label">Action</label><input class="form-control" @bind="ActionInput" placeholder="e.g. Login Success" /></div>
                <div class="col-md-auto align-self-end"><button class="btn btn-outline-primary" @onclick="() => ReloadAuditAsync(1)">Filter</button></div>
                <div class="col-md-auto align-self-end"><a class="btn btn-outline-secondary" href="@AuditExportUrl" target="_blank">Export CSV</a></div>
            </div>
            @if (AuditPage.Items.Count == 0)
            {
                <div class="alert alert-light">No audit log entry matches this filter.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead><tr><th scope="col">Username</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Result</th><th scope="col">Created</th></tr></thead>
                        <tbody>@foreach (var log in AuditPage.Items) { <tr><td>@log.Username</td><td>@log.Action</td><td>@log.EntityName@(log.EntityId is not null ? $" #{log.EntityId}" : "")</td><td>@log.Result</td><td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td></tr> }</tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(AuditPage.Page <= 1)" @onclick="() => ReloadAuditAsync(AuditPage.Page - 1)">Previous</button>
                    <span>Page @AuditPage.Page</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(AuditPage.Page * AuditPage.PageSize >= AuditPage.TotalCount)" @onclick="() => ReloadAuditAsync(AuditPage.Page + 1)">Next</button>
                </div>
            }
        </Authorized>
        <NotAuthorized><div class="alert alert-warning">You do not have permission to view the audit log.</div></NotAuthorized>
    </AuthorizeView>
}
else
{
    <AuthorizeView Policy="@PolicyNames.CanManageUsers">
        <Authorized Context="manageAuthorization">
            <h2 class="h4">Demo User Management</h2>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th scope="col">Username</th><th scope="col">Roles</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
                    <tbody>@foreach (var user in DemoUsers) {
                        <tr>
                            <td>@user.Username</td>
                            <td>@string.Join(", ", user.Roles)</td>
                            <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(user)">@(user.IsActive ? "Deactivate" : "Activate")</button></td>
                        </tr>
                    }</tbody>
                </table>
            </div>
        </Authorized>
        <NotAuthorized><div class="alert alert-warning">You do not have permission to manage demo users.</div></NotAuthorized>
    </AuthorizeView>
}

@code {
    private string Tab = "audit";
    private AuditLogPage AuditPage = new([], 1, 20, 0);
    private string SearchInput = "";
    private string ActionInput = "";
    private IReadOnlyCollection<DemoUser> DemoUsers = [];
    private string? Message;
    private StatusMessage.MessageKind MessageKind = StatusMessage.MessageKind.Info;

    // Only load what this actor is actually allowed to see. Previously both calls ran
    // unconditionally, so a Planner or Viewer opening this page still executed the audit-log
    // and demo-user queries even though AuthorizeView hid every result (finding A3).
    protected override async Task OnInitializedAsync()
    {
        var actor = await CurrentActorAsync();

        if (actor.IsInRole(RoleNames.Admin) || actor.IsInRole(RoleNames.Manager))
        {
            await ReloadAuditAsync(1);
        }

        if (actor.IsInRole(RoleNames.Admin))
        {
            DemoUsers = await AdminUsers.ListAsync(actor);
        }
    }

    private async Task ReloadAuditAsync(int page) =>
        AuditPage = await AuditLogs.ListAsync(new AuditLogQuery(
            string.IsNullOrWhiteSpace(SearchInput) ? null : SearchInput,
            string.IsNullOrWhiteSpace(ActionInput) ? null : ActionInput,
            Page: page));

    private async Task ToggleActiveAsync(DemoUser user)
    {
        var actor = await CurrentActorAsync();
        await AdminUsers.SetActiveAsync(actor, user.Id, !user.IsActive);
        DemoUsers = await AdminUsers.ListAsync(actor);
        Message = $"{user.Username} is now {(user.IsActive ? "inactive" : "active")}.";
        MessageKind = StatusMessage.MessageKind.Success;
    }

    // Carries the on-screen filter into the export so the CSV matches the table above it.
    private string AuditExportUrl
    {
        get
        {
            var parameters = new List<string>();
            if (!string.IsNullOrWhiteSpace(SearchInput))
            {
                parameters.Add($"search={Uri.EscapeDataString(SearchInput.Trim())}");
            }
            if (!string.IsNullOrWhiteSpace(ActionInput))
            {
                parameters.Add($"action={Uri.EscapeDataString(ActionInput.Trim())}");
            }

            return parameters.Count == 0
                ? "/api/reports/audit-log/export.csv"
                : $"/api/reports/audit-log/export.csv?{string.Join("&", parameters)}";
        }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> CurrentActorAsync() => (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
}
